# --- PostgreSQL (pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=snaproom
POSTGRES_USER=snaproom
POSTGRES_PASSWORD=secretpassword

# --- Spring Boot Backend ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/snaproom
SPRING_DATASOURCE_USERNAME=snaproom
SPRING_DATASOURCE_PASSWORD=secretpassword
JWT_SECRET=replace-with-256-bit-secret-key-for-snaproom-jwt-signing
AI_SERVICE_URL=http://localhost:8001

# --- Object Storage (Cloudflare R2 / AWS S3 / MinIO) ---
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET_NAME=snaproom-photos
AWS_ACCESS_KEY_ID=your_r2_or_s3_access_key
AWS_SECRET_ACCESS_KEY=your_r2_or_s3_secret_key

# --- Frontend (Next.js / React) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api