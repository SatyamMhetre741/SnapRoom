# --- PostgreSQL (pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=photo_sharing_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=MyNewPassword123

# --- Spring Boot Backend ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/photo_sharing_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=MyNewPassword123
JWT_SECRET=replace-with-256-bit-secret-key-for-snaproom-jwt-signing
AI_SERVICE_URL=http://localhost:8001

# --- Cloudflare R2 Object Storage ---
# Option A: Provide account ID (automatically resolves to https://<account_id>.r2.cloudflarestorage.com)
R2_ACCOUNT_ID=your_cloudflare_account_id
# Option B: Explicit endpoint URL
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
R2_BUCKET_NAME=snaproom-photos
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Optional: Public development domain or custom domain (e.g. https://pub-xxxx.r2.dev)
# --- Frontend (Next.js / React) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
