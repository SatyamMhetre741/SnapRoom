# ==============================================================================
# SnapRoom Full Stack Environment Configuration Template (.env.example)
# Copy this file to .env and adjust credentials as appropriate.
# ==============================================================================

# --- PostgreSQL + pgvector (Docker Port 5433) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=photo_sharing_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=MyNewPassword123

# --- Spring Boot Backend ---
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/photo_sharing_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=MyNewPassword123
JWT_SECRET=snaproom-super-secret-key-that-is-at-least-256-bits-long-for-jwt-signing-2026!
JWT_EXPIRATION_MS=604800000
AI_SERVICE_URL=http://localhost:8001

# --- Cloudflare R2 Object Storage ---
R2_ACCOUNT_ID=your_cloudflare_account_id
STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
R2_REGION=auto
R2_BUCKET_NAME=snaproom
STORAGE_BUCKET_NAME=snaproom
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Optional public domain or r2.dev domain (e.g. https://pub-xxxx.r2.dev)
R2_PUBLIC_URL=

# --- Room Lifecycles & Retention ---
ROOM_TTL_DAYS=2
ROOM_CLEANUP_RATE_MS=1800000
ROOM_CLEANUP_INITIAL_DELAY_MS=60000

# --- AI Service (FastAPI + InsightFace) ---
AI_SERVICE_PORT=8001
INSIGHTFACE_MODEL=buffalo_l
EXECUTION_PROVIDER=CPUExecutionProvider
DET_THRESH=0.5

# --- Frontend (Next.js / React) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
